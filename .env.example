# Copy to .env.local and fill in. Leave both empty (or delete this file) to run on the built-in sample content.
#
# Supabase dashboard -> Project Settings -> API
#   SUPABASE_URL       "Project URL"
#   SUPABASE_ANON_KEY  "anon" "public" key. Safe on the server: RLS only allows reads.
#
# Do NOT use the service_role key here. The site never writes.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# The names Supabase's Vercel integration creates also work (used if the two above are empty):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin of the deployed site. Used for Open Graph URLs, canonicals and sitemap.xml.
# On Vercel this can be left empty (VERCEL_URL is used), but a real domain is better for sharing.
NEXT_PUBLIC_SITE_URL=
